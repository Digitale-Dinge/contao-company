{% extends '@Contao/content_element/_base.html.twig' %}

{% block day_label %}{{ day|format_datetime(pattern: short_days ? 'EEE' : 'EEEE') }}{% endblock %}

{% block day_times %}
    {%- for range in hours -%}
        <span class="company_opening-times__interval">{{ range.start }}–{{ range.end }}</span>
    {%- else -%}
        {{ 'company.opening_times.closed_all_day'|trans({}, 'company') }}
    {%- endfor -%}
{% endblock %}

{% block day_rows %}
    {% for day, hours in opening_times.openingHours.forWeek %}
        <tr>
            <th scope="row">{{ block('day_label') }}</th>
            <td>{{ block('day_times') }}</td>
        </tr>
    {% endfor %}
{% endblock %}

{% block company_opening_status %}
    {{ include('@Contao/company/component/_opening_status.html.twig') }}
{% endblock %}

{% block company_opening_times_table %}
    <table class="company_opening-times__table">
        <caption class="invisible">{{ 'company.opening_times.table_caption'|trans({}, 'company') }}</caption>
        <thead class="invisible">
            <tr>
                <th scope="col">{{ 'company.opening_times.col_day'|trans({}, 'company') }}</th>
                <th scope="col">{{ 'company.opening_times.col_times'|trans({}, 'company') }}</th>
            </tr>
        </thead>
        <tbody>
            {{ block('day_rows') }}
        </tbody>
    </table>
{% endblock %}

{% block closing_period %}
    {% set company_closing_period_attributes = attrs(company_closing_period_attributes|default) %}
    {% set company_closing_reason_attributes = attrs(company_closing_reason_attributes|default)
        .addClass('company_closing-times__reason')
    %}
    {% set same_day = period.to == period.from %}
    {% set reason = period.reason|insert_tag|trim %}

    <li{{ company_closing_period_attributes }}>
        <time datetime="{{ period.from }}{{ period.from_time ? 'T' ~ period.from_time }}">
            {{- period.from|format_date -}}
            {{- period.from_time ? ', ' ~ 'company.opening_times.from_time'|trans({'%time%': period.from_time}, 'company') -}}
        </time>
        {%- if not same_day or period.to_time -%}
            {{ same_day ? ', ' : ' – ' -}}
            <time datetime="{{ period.to }}{{ period.to_time ? 'T' ~ period.to_time }}">
                {{- not same_day ? period.to|format_date -}}
                {{- not same_day and period.to_time ? ', ' -}}
                {{- period.to_time ? 'company.opening_times.until_time'|trans({'%time%': period.to_time}, 'company') -}}
            </time>
        {%- endif -%}
        {%- if reason %}: <span{{ company_closing_reason_attributes }}>{{ reason }}</span>{% endif %}
    </li>
{% endblock %}

{% block company_closing_times %}
    {% set company_closing_times_attributes = attrs(company_closing_times_attributes|default)
        .addClass('company_closing-times')
    %}

    {% if opening_times.closingTimes is not empty %}
        <p class="company_closing-times__headline">{{ 'company.opening_times.closing_times'|trans({}, 'company') }}</p>
        <ul{{ company_closing_times_attributes }}>
            {% for period in opening_times.closingTimes %}
                {{ block('closing_period') }}
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block content %}
    {{ block('company_opening_status') }}
    {{ block('company_opening_times_table') }}
    {{ block('company_closing_times') }}
{% endblock %}
