{%- block company_logo %}
    {% set company_model = company_model|default(company.get) %}
    {% if company_model|default and company_model.logo|default %}
        <{{ tag_name|default('div') }}{{ attrs(company_logo_attributes|default).addClass('company_logo') }}>
            {{- logo_prefix|default -}}
            {%- block logo_inner -%}
                {% set logoHref = app.request.baseUrl|default('/') %}
                {% if contao.page.urlPrefix|default %}
                    {% set logoHref = "#{logoHref}#{contao.page.urlPrefix}/" %}
                {% endif %}

                {{ include('@Contao/component/_figure.html.twig', {
                    figure: figure(company_model.logo, null, { linkHref: logoHref }),
                    figure_attributes: { class: figure_class|default },
                    img_attributes: {
                        class: 'logo ' ~ logo_class|default,
                        alt: company_model.name,
                    },
                }) }}
            {%- endblock -%}
            {%- block logo_after -%}{%- endblock -%}
            {{- logo_suffix|default -}}
        </{{ tag_name|default('div') }}>
    {% endif %}
{% endblock -%}
