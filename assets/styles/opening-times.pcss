.company_opening-status {
    color: var(--company-opening-status-color, inherit);
    font-weight: var(--company-opening-status-font-weight, normal);

    &.is-open {
        --company-opening-status-color: var(--kiss-sys-color-status-success-solid, #00c850);
    }

    &.is-closed {
        --company-opening-status-color: var(--kiss-sys-color-status-error-solid, #fb2c37);
    }
}

.company_opening-times__table {
    width: 100%;

    th {
        text-align: left;
        white-space: nowrap;
    }

    td {
        font-variant-numeric: tabular-nums;
    }
}

.company_opening-times__interval + .company_opening-times__interval {
    margin-inline-start: 0.5em;
}
