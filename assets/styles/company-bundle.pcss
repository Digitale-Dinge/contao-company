.company_opening_times {
    margin: .5rem 0;

    .tl_text {
        width: 4.5em;
        text-align: right;
        font-variant-numeric: tabular-nums;
        height: 26px;
        padding: 2px 6px;
        margin: 1px 0;
    }

    tbody {
        th {
            vertical-align: bottom;
            line-height: 30px;
        }

        tr:first-child,
        tr:nth-child(6) {
            .tl_text {
                margin-top: .5rem;
            }
        }
    }

    .tl_text::placeholder {
        opacity: .4;
    }

    .tl_text[aria-invalid="true"] {
        border-color: var(--red);
    }

    th:first-child {
        padding-right: .5rem;
    }

    th:not(:first-child) {
        text-align: center;
    }

    th:nth-child(4),
    td:nth-child(4) {
        padding-left: .5rem;
    }

    thead {
        th:first-child {
            opacity: .5;
        }
    }
}

.widget > .company_opening_times_error {
    min-height: 1lh;
    font-size: .75rem;
    line-height: 1.3;

    .tl_error {
        margin: 0;
    }
}
